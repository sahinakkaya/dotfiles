{
    "global": { "show_in_menu_bar": false },
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Use right_command as F18 in kitty, Zen tab navigation, and command+option+control everywhere else",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "bundle_identifiers": [
                                            "^app\\.zen-browser\\.zen$"
                                        ],
                                        "type": "frontmost_application_if"
                                    },
                                    {
                                        "name": "right_gui_in_zen",
                                        "type": "variable_if",
                                        "value": 1
                                    }
                                ],
                                "from": {
                                    "key_code": "j",
                                    "modifiers": {
                                        "mandatory": ["left_command", "left_control", "left_option"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "tab",
                                        "modifiers": ["left_control"]
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "conditions": [
                                    {
                                        "bundle_identifiers": [
                                            "^app\\.zen-browser\\.zen$"
                                        ],
                                        "type": "frontmost_application_if"
                                    },
                                    {
                                        "name": "right_gui_in_zen",
