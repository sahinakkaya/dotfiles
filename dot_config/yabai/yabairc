#!/bin/bash

# === Load Scripting Additions ===

# sudo nvram boot-args=-arm64e_preview_abi
# sudo yabai --uninstall-sa
# sudo yabai --install-sa

yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"

yabai -m signal --add app='^Ghostty$' event=window_created action='yabai -m space --layout bsp'
yabai -m signal --add app='^Ghostty$' event=window_destroyed action='yabai -m space --layout bsp'
sudo yabai --load-sa

yabai -m signal --add event=window_focused action="sketchybar --trigger window_focus"
yabai -m signal --add event=window_created action="sketchybar --trigger windows_on_spaces"
yabai -m signal --add event=window_destroyed action="sketchybar --trigger windows_on_spaces"
# yabai -m signal --add event=display_added action="sleep 2 && $HOME/.config/yabai/create_spaces.sh"
# yabai -m signal --add event=display_removed action="sleep 1 && $HOME/.config/yabai/create_spaces.sh"
$HOME/.config/yabai/create_spaces.sh

# === Tiling setting ===
                          # active_window_border_color  0xE032CD32 \
                          # normal_window_border_color  0xE02d74da \

yabai -m config layout    bsp                                    \
                          top_padding                 4          \
                          bottom_padding              4          \
                          left_padding                4          \
                          right_padding               4          \
                          window_gap                  6          \
                                                                 \
                          mouse_follows_focus         off        \
                          focus_follows_mouse         off        \
                          window_zoom_persist         off        \
                                                                 \
                          window_topmost              off        \
                          window_opacity              off        \
                          window_shadow               float      \
                                                                 \
                          window_border               on         \
                          window_border_width         2          \
                          window_border_hidpi         off        \
                          window_border_radius        11         \
                          window_border_blur          off        \
                          window_animation_duration   0.3        \
                          active_window_border_color  0xffe1e3e4 \
                          normal_window_border_color  0xff494d64 \
                          insert_feedback_color       0x00010101 \
                          window_opacity_duration     0.0        \
                          active_window_opacity       1.0        \
                          normal_window_opacity       0.90       \
                          split_ratio                 0.50       \
                                                                 \
                          auto_balance                off        \
                                                                 \
                          mouse_modifier              fn         \
                          mouse_action1               move       \
                          mouse_action2               resize     \
                          mouse_drop_action           swap       \
                          # external_bar 		            all:30:0   \
# ===== Rules ==================================

yabai -m rule --add label="Finder" app="^Finder$" title="(Co(py|nnect)|Move|Info|Pref)" manage=off
yabai -m rule --add label="Safari" app="^Safari$" title="^(General|(Tab|Password|Website|Extension)s|AutoFill|Se(arch|curity)|Privacy|Advance)$" manage=off
yabai -m rule --add label="macfeh" app="^macfeh$" manage=off
yabai -m rule --add label="System Preferences" app="^System Preferences$" title=".*" manage=off
yabai -m rule --add label="About This Mac" app="System Information" title="About This Mac" manage=off
yabai -m rule --add label="App Store" app="^App Store$" manage=off
yabai -m rule --add app="^(LuLu|Calculator|Software Update|Dictionary|VLC|System Preferences|System Settings|zoom.us|Photo Booth|Archive Utility|Python|LibreOffice|App Store|Steam|Alfred|Activity Monitor)$" manage=off
yabai -m rule --add label="Activity Monitor" app="^Activity Monitor$" manage=off
yabai -m rule --add label="KeePassXC" app="^KeePassXC$" manage=off
yabai -m rule --add label="Calculator" app="^Calculator$" manage=off
yabai -m rule --add label="Dictionary" app="^Dictionary$" manage=off
yabai -m rule --add label="mpv" app="^mpv$" manage=off
yabai -m rule --add label="Software Update" title="Software Update" manage=off
yabai -m rule --add label="HHKB" app="HHKB Keymap Tool" title="About This Mac" manage=off

