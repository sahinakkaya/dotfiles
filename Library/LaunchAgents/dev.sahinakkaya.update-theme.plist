<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.sahinakkaya.update-theme</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/dark-notify</string>
    <string>-c</string>
    <string>/Users/sahin/.local/bin/update-theme</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/dev.sahinakkaya.update-theme.out.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/dev.sahinakkaya.update-theme.err.log</string>
</dict>
</plist>
