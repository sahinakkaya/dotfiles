[user]
	email = sahin@sahinakkaya.dev
	name = Şahin Akkaya
{{ if .personalSecrets -}}
	signingkey = sahin@sahinakkaya.dev
{{ end -}}
[init]
	defaultBranch = main


[diff]
    ; tool = kitty
    ; guitool = kitty.gui
[difftool]
    ; prompt = false
    ; trustExitCode = true
[difftool "kitty"]
    cmd = kitten diff $LOCAL $REMOTE
[difftool "kitty.gui"]
    cmd = kitten diff $LOCAL $REMOTE

[diff]
        tool = difftastic
        external = difft

[difftool]
        prompt = false

[difftool "difftastic"]
        cmd = difft "$LOCAL" "$REMOTE"

[pager]
        difftool = true

# `git dlog` to show `git log -p` with difftastic.
[alias]
        dlog = "-c diff.external=difft log -p --ext-diff"
{{ if .personalSecrets -}}
[gpg]
	format = openpgp
[commit]
	gpgsign = true
[tag]
	gpgSign = true

{{ else -}}
[commit]
	gpgsign = false
[tag]
	gpgSign = false
{{ end -}}
