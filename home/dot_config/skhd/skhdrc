lalt + shift - t : skhd -k "cmd + shift - t"

# restart yabai
lalt + ctrl - r: yabai --restart-service
# lock screen immediately
alt + ctrl - n : pmset displaysleepnow
# logout
alt + ctrl - q : osascript -e 'tell app "System Events" to log out'
# power down
meh - q : osascript -e 'tell app "System Events" to shut down'
# reboot
meh - r : osascript -e 'tell app "System Events" to restart'
