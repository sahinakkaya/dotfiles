# open terminal inside 
# lalt - return : /Applications/kitty.app/Contents/MacOS/kitty --single-instance -d ~
cmd- return : /Applications/kitty.app/Contents/MacOS/kitty --single-instance -d ~

cmd - z [
    "alacritty" : skhd -k "ctrl - z"
    "*"    ~
]

