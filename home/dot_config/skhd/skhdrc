# create a space
hyper - n : yabai -m space --create; \
		sketchybar --update

# destroy current space
hyper - d : yabai -m space --destroy

# === Modification === 
# Move window relatively
lalt + shift - h : yabai -m window --warp west
lalt + shift - j : yabai -m window --warp south
lalt + shift - k : yabai -m window --warp north
lalt + shift - l : yabai -m window --warp east

lalt + shift - left : yabai -m window --warp west
lalt + shift - down : yabai -m window --warp south
lalt + shift - up : yabai -m window --warp north
lalt + shift - right : yabai -m window --warp east

lalt + ctrl - h : yabai -m window --resize left:-50:0; \
                  yabai -m window --resize right:-50:0
lalt + ctrl - j : yabai -m window --resize bottom:0:50; \
                  yabai -m window --resize top:0:50
lalt + ctrl - k   : yabai -m window --resize top:0:-50; \
                  yabai -m window --resize bottom:0:-50
lalt + ctrl - l : yabai -m window --resize right:50:0; \
                  yabai -m window --resize left:50:0

# Make window native fullscreen
alt - f : yabai -m window --toggle zoom-fullscreen; sketchybar --trigger window_focus
alt - m : yabai -m window --toggle native-fullscreen; sketchybar --trigger window_focus
alt + shift - return : yabai -m window --toggle zoom-parent; sketchybar --trigger window_focus
# shift + alt - f : yabai -m window --toggle float
# alt - space : yabai -m window --toggle float

# send window to space
lalt + shift - tab : yabai -m window --space recent && sketchybar --trigger windows_on_spaces
lalt + shift - 1 : yabai -m window --space 1 && sketchybar --trigger windows_on_spaces
lalt + shift - 2 : yabai -m window --space 2 && sketchybar --trigger windows_on_spaces
lalt + shift - 3 : yabai -m window --space 3 && sketchybar --trigger windows_on_spaces
lalt + shift - 4 : yabai -m window --space 4 && sketchybar --trigger windows_on_spaces
lalt + shift - 5 : yabai -m window --space 5 && sketchybar --trigger windows_on_spaces
lalt + shift - 6 : yabai -m window --space 6 && sketchybar --trigger windows_on_spaces
lalt + shift - 7 : yabai -m window --space 7 && sketchybar --trigger windows_on_spaces
lalt + shift - 8 : yabai -m window --space 8 && sketchybar --trigger windows_on_spaces

# Move focus + window to space
lalt + ctrl - m : yabai -m window --space last; yabai -m space --focus last
lalt + ctrl - p : yabai -m window --space prev; yabai -m space --focus prev
lalt + ctrl - n : yabai -m window --space next; yabai -m space --focus next
lalt + ctrl - 1 : yabai -m window --space 1; yabai -m space --focus 1
lalt + ctrl - 2 : yabai -m window --space 2; yabai -m space --focus 2
lalt + ctrl - 3 : yabai -m window --space 3; yabai -m space --focus 3
lalt + ctrl - 4 : yabai -m window --space 4; yabai -m space --focus 4

alt - q : yabai -m window --close
# Equalize size of windows
alt - 0x18 : yabai -m space --balance

