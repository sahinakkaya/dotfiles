{{ if eq .chezmoi.os "darwin" -}}
# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config


Host fedora
  HostName localhost
  Port 3333
  User root
{{- else if eq .chezmoi.os "linux" -}}
Host arch
  Hostname 192.168.1.103
  RequestTTY yes
  RemoteCommand ZDOTDIR=/home/sahin/.config/zsh zsh
{{ end  }}


Host *
  ServerAliveInterval 120
  ServerAliveCountMax 30
  TCPKeepAlive no
  AddKeysToAgent yes

Host sahinakkaya
  HostName sahinakkaya.dev

Host sahinakkaya.dev
  IdentityFile ~/.ssh/id_ed25519
  Port 2242
  User sahin
  ForwardAgent yes
  AddKeysToAgent yes
  UseKeychain yes

Host home.ts.net
  IdentityFile ~/.ssh/id_ed25519
  ForwardAgent yes
  AddKeysToAgent yes
  UseKeychain yes


Host git.sahinakkaya.dev
  IdentityFile ~/.ssh/id_ed25519
  Port 2242


