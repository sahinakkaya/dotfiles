{{- $key := joinPath .chezmoi.homeDir ".ssh/id_ed25519.pub" -}}
{{- if stat $key -}}
{{ include $key }}
{{- else if has .chezmoi.os (list "darwin" "linux") -}}
{{- $prefix := ternary "macos" "fedora" (eq .chezmoi.os "darwin") -}}
{{ printf "%s %s@%s\n" ((bitwarden "item" (printf "%s-ssh-key" $prefix)).sshKey.publicKey | trim) .chezmoi.username .chezmoi.hostname }}
{{- end -}}
