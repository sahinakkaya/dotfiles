#!/usr/bin/env bash

set -o pipefail

if (( $# == 0 )) && [[ -t 0 ]]; then
    printf 'Usage: %s command [argument ...]\n       command | %s\n' "${0##*/}" "${0##*/}" >&2
    exit 64
fi

# Select clipboard utility.
# Kitty sends text to the client clipboard, including over SSH.
if [[ "${TERM:-}" == xterm-kitty || -n "${KITTY_WINDOW_ID:-}" ]] && command -v kitten >/dev/null 2>&1; then
  clipboard=(kitten clipboard --wait-for-completion)
else
  case "$(uname -s)" in
      Darwin)
          clipboard=(pbcopy)
          ;;
      Linux)
          if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
              clipboard=(wl-copy)
          elif [[ -n "${DISPLAY:-}" ]]; then
              clipboard=(xclip -selection clipboard)
          else
              printf 'No supported graphical clipboard available.\n' >&2
              exit 69
          fi
          ;;
      *)
          printf 'Unsupported operating system.\n' >&2
          exit 69
          ;;
  esac
fi

if ! command -v "${clipboard[0]}" >/dev/null 2>&1; then
    printf 'Missing clipboard utility: %s\n' "${clipboard[0]}" >&2
    exit 69
fi

tmpfile=$(mktemp "${TMPDIR:-/tmp}/cpyout.XXXXXX") || exit 1
trap 'rm -f "$tmpfile"' EXIT

if (( $# == 0 )); then
    # With no command arguments, capture piped or redirected input.
    tee "$tmpfile" || exit 1
    status=0
else
    # Print the command with shell-safe quoting.
    {
        printf '$'
        for argument in "$@"; do
            case "$argument" in
                ''|*[!a-zA-Z0-9_./,:=+@%-]*)
                    if [[ "$argument" == *"'"* || "$argument" == *$'\n'* || "$argument" == *$'\r'* || "$argument" == *$'\t'* ]]; then
                        printf ' %q' "$argument"
                    else
                        printf " '%s'" "$argument"
                    fi
                    ;;
                *) printf ' %s' "$argument" ;;
            esac
        done
        printf '\n'
    } | tee "$tmpfile" || exit 1

    # Execute the command, capturing stdout and stderr.
    "$@" 2>&1 | tee -a "$tmpfile"
    pipeline_status=("${PIPESTATUS[@]}")
    status=${pipeline_status[0]}
    if (( pipeline_status[1] != 0 )); then
        printf 'Failed to capture command output.\n' >&2
        exit 1
    fi
fi

# Copy captured output to the clipboard.
if "${clipboard[@]}" < "$tmpfile"; then
    printf 'Copied command output to the clipboard.\n' >&2
else
    printf 'Failed to copy output to the clipboard.\n' >&2
    exit 1
fi

exit "$status"
