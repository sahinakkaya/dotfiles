{{ if .personalSecrets -}}
#!/bin/sh
set -eu

# Rerun when the setup scripts or password-store configuration change.
# setup: {{ include ".scripts/setup-password-store.sh" | sha256sum }}
# ssh: {{ include ".scripts/prepare-password-store-ssh.sh" | sha256sum }}
# config: {{ include ".password-manager.json" | sha256sum }}

export PATH="$HOME/.local/bin:$PATH"
if [ -t 0 ]; then
    GPG_TTY="$(tty)"
    export GPG_TTY
fi

sh {{ joinPath .chezmoi.sourceDir ".scripts/setup-password-store.sh" | quote }} {{ joinPath .chezmoi.sourceDir ".password-manager.json" | quote }}
{{ end -}}
