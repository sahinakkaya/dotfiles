{{- if and (or .is_macos .is_linux) .personalSecrets -}}
{{ if .is_macos -}}
#!/opt/local/bin/python3
{{ else -}}
#!/usr/bin/env python3
{{ end -}}
import base64
import os
import tempfile
from pathlib import Path

from cryptography.hazmat.primitives import serialization

key_path = Path.home() / ".ssh/id_ed25519"

if key_path.is_symlink():
    raise RuntimeError(f"Refusing to replace symbolic link {key_path}")
if not key_path.is_file():
    raise RuntimeError(f"SSH key does not exist at {key_path}")


# The private-key template has written the unencrypted key. The preceding
# private passphrase template supplies this short-lived, base64-encoded file.
private_key = key_path.read_bytes()
passphrase_path = key_path.with_name(f".{key_path.name}.passphrase")


try:
    key = serialization.load_ssh_private_key(private_key, password=None)
except TypeError as exc:
    # cryptography raises TypeError when a private key already needs a
    # passphrase. The script has completed successfully in that case.
    if "password" in str(exc).lower():
        raise SystemExit(0)
    raise

try:
    passphrase = base64.b64decode(passphrase_path.read_bytes())
finally:
    try:
        passphrase_path.unlink()
    except FileNotFoundError:
        pass
if not passphrase:
    raise RuntimeError("SSH key passphrase is empty")

encrypted = key.private_bytes(
    encoding=serialization.Encoding.PEM,
    format=serialization.PrivateFormat.OpenSSH,
    encryption_algorithm=serialization.BestAvailableEncryption(
        passphrase
    ),
)

# The template wrote the unencrypted key. Replace it atomically so a failed
# conversion never leaves a partially written private key.
fd, temporary_path = tempfile.mkstemp(
    dir=key_path.parent, prefix=f".{key_path.name}.", suffix=".tmp"
)
try:
    with os.fdopen(fd, "wb") as f:
        f.write(encrypted)
        f.flush()
        os.fsync(f.fileno())
    os.replace(temporary_path, key_path)
except BaseException:
    try:
        os.unlink(temporary_path)
    except FileNotFoundError:
        pass
    raise


print(f"Encrypted SSH key written to {key_path}")
{{ end -}}
