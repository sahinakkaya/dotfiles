#!/bin/bash

set -eufo pipefail

{{ $python := and (dig "features" "python" false .) (not .headless) (not .ephemeral) (not .work) -}}
{{ $ports := .packages.macports -}}
{{ if .headless -}}
{{   $ports = concat $ports .packages.macports_headless -}}
{{ end -}}
{{ if $python -}}
{{   $ports = concat $ports .packages.macports_python -}}
{{ end -}}
{{ if and (dig "features" "uosc" false .) (not .headless) (not .ephemeral) (not .work) -}}
{{   $ports = concat $ports .packages.macports_uosc -}}
{{ end -}}

sudo port install \
{{ range ($ports | sortAlpha | uniq) -}}
    {{ . | quote }} \
{{ end -}}
    # End of MacPorts package list.

{{ if $python -}}
sudo port select --set python3 python314
sudo port select --set python python314
sudo port select --set pip3 pip314
sudo port select --set pip pip314
{{ end -}}
{{ if not .headless -}}

# Install missing Homebrew packages without upgrading existing installations.
brew trust --formula jorgelbg/tap/pinentry-touchid
brew bundle --no-upgrade --file=/dev/stdin <<'EOF'
{{ range (.packages.homebrew_formulae | sortAlpha | uniq) -}}
brew {{ . | quote }}
{{ end -}}
{{ range (.packages.homebrew_casks | sortAlpha | uniq) -}}
cask {{ . | quote }}
{{ end -}}
EOF
{{ end -}}
