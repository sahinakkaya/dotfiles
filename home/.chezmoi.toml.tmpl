[add]
secrets = "error"

[bitwarden]
unlock = "auto"

[merge]
command = "nvim"
args = [
    "-d",
    "{{ "{{ .Destination }}" }}",
    "{{ "{{ .Source }}" }}",
    "{{ "{{ .Target }}" }}"
]

[hooks.read-source-state.pre]
command = "sh"
args = ["{{ .chezmoi.sourceDir }}/.scripts/ensure-gpg-key.sh"]
